      "blocks": [
        {
          "id": "b02",
          "text": "Exponent first. Three squared is nine.",
          "display": "18 − 2 × 9 ÷ 6",
          "cue": "step-1"
        },
        {
          "id": "b03",
          "text": "Multiplication and division share a level, so left to right. Two times nine is eighteen.",
          "display": "18 − 18 ÷ 6",
          "cue": "step-2"
        },
        {
          "id": "b04",
          "text": "Eighteen divided by six is three.",
          "display": "18 − 3",
          "cue": "step-3"
        },
        {
          "id": "b05",
          "text": "Finally, eighteen minus three is fifteen.",
          "display": "15",
          "cue": "step-4"
        }
      ]
    },
