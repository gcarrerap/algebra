      "title": "The problem",
      "blocks": [
        {
          "id": "b01",
          "text": "Let's solve this one step by step. Five times the quantity x plus two.",
          "display": "5(x + 2)",
          "cue": "show-problem",
          "pause_after_s": 1.2
        }
      ]
    },
    {
      "id": "s02",
      "title": "Step by step",
      "blocks": [
        {
          "id": "b02",
          "text": "The five outside multiplies every term inside. Five times x, plus five times two.",
          "display": "5 · x + 5 · 2",
          "cue": "step-1"
        },
        {
          "id": "b03",
          "text": "Five times x is five x, and five times two is ten.",
          "display": "5x + 10",
          "cue": "step-2"
        }
      ]
    },
    {
      "id": "s03",
      "title": "The answer",
      "blocks": [
        {
          "id": "b04",
          "text": "So the answer is five x plus ten.",
          "display": "= 5x + 10",
          "cue": "answer"
        },
        {
          "id": "b05",
          "text": "Watch out for these traps. If you multiply only the x, you get five x plus two. If you add five and two, you get five x plus seven.",
          "cue": "traps"
        }
      ]
    }
  ]
