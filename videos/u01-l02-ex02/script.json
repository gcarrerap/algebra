      "blocks": [
        {
          "id": "b02",
          "text": "Subtract four x from both sides. Five x minus seven equals eight.",
          "display": "5x − 7 = 8",
          "cue": "step-1"
        },
        {
          "id": "b03",
          "text": "Undo the minus seven by adding seven to both sides: five x equals fifteen.",
          "display": "5x = 15",
          "cue": "step-2"
        },
        {
          "id": "b04",
          "text": "Divide both sides by five. x equals three.",
          "display": "x = 3",
          "cue": "step-3"
        }
      ]
    },
