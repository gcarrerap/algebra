      "blocks": [
        {
          "id": "b01",
          "text": "Let's solve this one step by step. Two x plus nine equals six x plus twenty-one. Solve for x.",
          "display": "2x + 9 = 6x + 21",
          "cue": "show-problem",
          "pause_after_s": 1.2
        }
      ]
    },
    {
      "id": "s02",
      "title": "Step by step",
      "blocks": [
        {
          "id": "b02",
          "text": "Subtract two x from both sides, so the larger x term stays positive. Nine equals four x plus twenty-one.",
          "display": "9 = 4x + 21",
          "cue": "step-1"
        },
        {
          "id": "b03",
          "text": "Subtract twenty-one from both sides. Nine minus twenty-one is negative twelve.",
          "display": "−12 = 4x",
          "cue": "step-2"
        },
        {
          "id": "b04",
          "text": "Divide both sides by four. x equals negative three.",
          "display": "x = −3",
          "cue": "step-3"
        }
      ]
    },
    {
      "id": "s03",
      "title": "The answer",
      "blocks": [
        {
          "id": "b05",
          "text": "So x equals negative three.",
          "display": "x = −3",
          "cue": "answer"
        },
        {
          "id": "b06",
          "text": "Watch out for these traps. If you lose the negative sign, you get three. If you add twenty-one instead of subtracting it, you get fifteen over two.",
          "cue": "traps"
        }
      ]
    }
  ]
