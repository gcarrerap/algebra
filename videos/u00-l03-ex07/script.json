          "text": "The term we want is m, the middle one.",
          "display": "m = 1 · m",
          "cue": "step-1"
        },
        {
          "id": "b03",
          "text": "No number is written in front of m, so its coefficient is one.",
          "display": "1",
          "cue": "step-2"
        }
      ]
    },
    {
      "id": "s03",
      "title": "The answer",
      "blocks": [
