          "cue": "step-2"
        },
        {
          "id": "b04",
          "text": "Eight times one hundred is eight hundred. Eight times two is sixteen.",
          "display": "800 + 16",
          "cue": "step-3"
        },
        {
          "id": "b05",
          "text": "Eight hundred plus sixteen is eight hundred sixteen.",
          "display": "816",
          "cue": "step-4"
        }
      ]
    },
