      "blocks": [
        {
          "id": "b02",
          "text": "The last nine is nine times one.",
          "display": "9 × 99 + 9 × 1",
          "cue": "step-1"
        },
        {
          "id": "b03",
          "text": "Now both parts have a nine, so we can pull it out: nine times the quantity ninety-nine plus one.",
          "display": "9 × (99 + 1)",
          "cue": "step-2"
        },
        {
          "id": "b04",
          "text": "Ninety-nine plus one is one hundred.",
          "display": "9 × 100",
          "cue": "step-3"
        },
        {
          "id": "b05",
          "text": "Nine times one hundred is nine hundred.",
          "display": "900",
          "cue": "step-4"
        }
      ]
    },
    {
      "id": "s03",
      "title": "The answer",
      "blocks": [
